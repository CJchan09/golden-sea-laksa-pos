# Optional local experiment only. Never connect the public demo to a real
# merchant Sheet or customer data source. Vite exposes VITE_* values to the
# browser, so these URLs are not secrets.
VITE_GAS_URL=""
VITE_SHEET_URL=""

# The public demo skips Staff, KDS, and History password gates. Keep this false
# for a private/formal build. Local development defaults to demo mode when the
# value is omitted.
VITE_PUBLIC_DEMO="false"
